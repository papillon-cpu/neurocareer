# Скопируйте в .env.local и заполните. Секреты не коммитятся.

# PostgreSQL. Если не задано — локально используется встроенная БД в папке .data (PGlite).
# DATABASE_URL=postgres://user:password@localhost:5432/neurocareer

# Для `npm run db:seed` (создаёт администратора; пароль не короче 12 символов)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- AI (этап 6). Без ключей AI честно показывается как «не подключён». ---
# Провайдера и модель можно выбрать в админке («AI»): выбор хранится в базе, ключи — только здесь.
# Основной провайдер: anthropic (по умолчанию) или openai. Резервный — необязательно.
# AI_PRIMARY_PROVIDER=anthropic   # anthropic | openai | gigachat | yandexai | yandex; без значения берётся первый настроенный
# AI_FALLBACK_PROVIDER=openai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=            # обязательно для OpenAI: актуальное название модели
# GigaChat (Сбер): работает из России, оплата в рублях. Ключ авторизации берётся в личном кабинете developers.sber.ru.
# GIGACHAT_AUTH_KEY=
# GIGACHAT_MODEL=          # обязательно: название модели из вашего кабинета
# GIGACHAT_SCOPE=GIGACHAT_API_PERS   # физлицо; для ИП и организаций GIGACHAT_API_B2B или GIGACHAT_API_CORP
# GIGACHAT_BASE_URL=       # по умолчанию https://api.giga.chat/v1
# YandexGPT в AI Studio (OpenAI-совместимый API): работает из России, оплата рублями.
# Ключ и folder id берутся в консоли Yandex Cloud → AI Studio (роль ai.languageModels.user).
# YANDEX_AI_KEY=
# YANDEX_AI_FOLDER=        # идентификатор каталога в Yandex Cloud
# YANDEX_AI_MODEL=         # обязательно: например yandexgpt-5.1 (полная gpt://<folder>/<model> тоже можно)
# YandexGPT (старый API Yandex Cloud): для кабинетов, настроенных ранее.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=        # идентификатор каталога в Yandex Cloud
# YANDEX_MODEL=            # обязательно: например yandexgpt/latest (актуальное название смотрите в каталоге моделей)
# GIGACHAT_OAUTH_URL=      # по умолчанию https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Переопределение провайдера для задачи: AI_ASSISTANT_PROVIDER, AI_RESUME_PARSE_PROVIDER, AI_RESUME_REWRITE_PROVIDER, AI_REPORT_COMMENTARY_PROVIDER, AI_OPEN_FEEDBACK_PROVIDER
# Лимиты на пользователя:
# AI_REQUESTS_PER_HOUR=30
# AI_MONTHLY_TOKENS_PER_USER=300000

# Появятся в следующих этапах:
# S3_ENDPOINT= / S3_BUCKET= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=
# Оплата (этап 8). sandbox — ТЕСТОВЫЙ режим без реальных денег; вне production включён по умолчанию.
# Реальный провайдер подключается кодом (см. docs/ARCHITECTURE.md), в production без него оплата недоступна.
# BILLING_PROVIDER=sandbox
# BILLING_WEBHOOK_SECRET=   # секрет подписи webhook (для sandbox необязателен локально)

# Демо-режим: кнопки переключения «Админ / Работодатель / Сотрудник» в шапке (входят в демо-аккаунты без пароля).
# При разработке включён сам; в production работает только при DEMO_MODE=1 (используйте только на закрытом тестовом стенде).
# Демо-аккаунты создаёт `npm run db:seed -- --demo`.
# DEMO_MODE=1

# Почта (восстановление пароля). Без ключей письма в разработке печатаются в консоль сервера, в production не отправляются.
# APP_URL=https://example.com      # база для ссылок в письмах
# RESEND_API_KEY=
# MAIL_FROM="NEUROCAREER <noreply@example.com>"
