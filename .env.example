# Скопируйте в .env.local и заполните. Секреты не коммитятся.

# PostgreSQL. Если не задано — локально используется встроенная БД в папке .data (PGlite).
# DATABASE_URL=postgres://user:password@localhost:5432/neurocareer

# Для `npm run db:seed` (создаёт администратора; пароль не короче 12 символов)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- AI (этап 6). Без ключей AI честно показывается как «не подключён». ---
# Основной провайдер: anthropic (по умолчанию) или openai. Резервный — необязательно.
# AI_PRIMARY_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=openai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=            # обязательно для OpenAI: актуальное название модели
# Переопределение провайдера для задачи: AI_ASSISTANT_PROVIDER, AI_RESUME_PARSE_PROVIDER, AI_RESUME_REWRITE_PROVIDER, AI_REPORT_COMMENTARY_PROVIDER
# Лимиты на пользователя:
# AI_REQUESTS_PER_HOUR=30
# AI_MONTHLY_TOKENS_PER_USER=300000

# Появятся в следующих этапах:
# S3_ENDPOINT= / S3_BUCKET= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=
# Оплата (этап 8). sandbox — ТЕСТОВЫЙ режим без реальных денег; вне production включён по умолчанию.
# Реальный провайдер подключается кодом (см. docs/ARCHITECTURE.md), в production без него оплата недоступна.
# BILLING_PROVIDER=sandbox
# BILLING_WEBHOOK_SECRET=   # секрет подписи webhook (для sandbox необязателен локально)
